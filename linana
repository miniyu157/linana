#!/usr/bin/env bash

# shellcheck disable=SC2155

pure::get_mntns_by_pid() { readlink "/proc/${1}/ns/mnt" | grep -oP '\d+'; }

# Print error message to stderr and exit
app::die() {
    # shellcheck disable=SC2059
    printf -- "$@" >&2
    exit 1
}

# 获取当前容器是否运行，自动失败返回状态码
this::check_running() { [[ -f ${GLOBAL[pidfile]} ]] && nsenter -t "$(< "${GLOBAL[pidfile]}")" -m -- mountpoint -q "${GLOBAL[mountpoint]}" 2> /dev/null; }

# 容器需要运行，否则报错退出
check::is_already_running() { this::check_running || app::die "${_err}×${_off} Container not running: ${GLOBAL[imghash]}\n"; }

# --img 需要设置，否则报错退出
check::img() { [[ -n ${OPTIONS[img]} ]] || app::die "${_err}×${_off} --img is required for this command.\n"; }

# 获取当前容器的实例，打印 PID 或 mntns
this::ensure_ns() {
    case "$1" in
        pid)
            this::check_running && {
                cat "${GLOBAL[pidfile]}"
                return 0
            }

            setsid unshare -m -u sleep infinity > /dev/null 2>&1 &
            local pid=$!
            printf '%s\n' "$pid" | tee "${GLOBAL[pidfile]}"
            ;;
        mntns)
            local pid=$(this::ensure_ns pid)
            pure::get_mntns_by_pid "$pid"
            ;;
    esac
}

# 为当前容器挂载镜像
this::set_mp() {
    mountpoint -q "${GLOBAL[mountpoint]}" || {
        printf "%b" "Mount IMG: ${OPTIONS[img]} -> ${GLOBAL[mountpoint]}\n"
        mkdir -p "${GLOBAL[mountpoint]}"
        mount "${OPTIONS[img]}" "${GLOBAL[mountpoint]}"
    }
}

# 为当前容器挂载文件系统
this::mountfs() {
    local nspid=$(this::ensure_ns pid) mntns=$(this::ensure_ns mntns)

    printf "Mount FileSystem...(mntns: %s)\n" "$mntns"
    nsenter -t "$nspid" -m -u -- bash -s "${GLOBAL[mountpoint]}" "${OPTIONS[android_storage]:-0}" << 'SCRIPT'
        MP=$1 STORAGE=${2:-0}
        mounts=(/dev:bind /dev/pts:bind /proc:bind /sys:bind /tmp:tmpfs /run:tmpfs)
        ((STORAGE==1)) && mounts+=("/storage/emulated/0:rbind")
for entry in "${mounts[@]}"; do
    IFS=: read -r src mtype <<< "$entry"
    dst="${MP%/}${src}"
    mkdir -p "$dst"
    mountpoint -q "$dst" && continue
    case $mtype in
        bind|rbind) display=$src; [[ -d $src ]] || display="SKIP"
                    printf "%b" "  $display -> $dst\n"
                    [[ -d $src ]] && mount --$mtype "$src" "$dst" ;;
        tmpfs)      printf "%b" "  tmpfs -> $dst\n"
                    mount -t tmpfs tmpfs "$dst" ;;
    esac
done
SCRIPT
}

app::escalate() {
    local shell=$(command -v bash || printf "%s" "/data/data/com.termux/files/usr/bin/bash")
    (($(id -u) != 0)) && {
        [[ -f /system/build.prop ]] || app::die "${_err}×${_off} Non-Android environment. Please run with sudo.\n"
        exec su --mount-master -c "$(printf "%q " env -i PATH=/data/data/com.termux/files/usr/bin:/system/bin:/system/xbin HOME=/data/data/com.termux/files/home/.suroot TERM="$TERM" LD_PRELOAD="/data/data/com.termux/files/usr/lib/libtermux-exec-ld-preload.so" "$shell" "$(readlink -f "$0")" "${SCRIPT_ARGV[@]}")"
    }
}

usage() {
    cat << EOF
${_b}${0##*/} -- A minimal chroot container runtime implemented in Bash${_off}

${_yellow}　 ／l、 ${_off}Automatically preserves the Termux environment   ${_c1}/ᐠ˵>˕<˵マ${_off}
${_yellow} （ﾟ､ ｡ ７  ${_off}during privilege escalation. Only mount and UTS   ${_c2} ₍^. .^₎⟆${_off}
${_yellow}　l、 ~ヽ    ${_off}namespaces are used — PID and USER namespace support is not required.
${_yellow}　じしf_,)ノ  ${_hl}✦ https://github.com/miniyu157/linana ✦${_off}  ${_c3} ^>_<^=₎~${_off}  ${_c4}₍^ >ヮ<^₎${_off}

${_title}Usage: ${0##*/} [Options] <Command> [args]${_off}

${_title}Options:${_off}
  -i, --img <PATH>          Specify the path to the rootfs image
  -S, --android-storage     Mount Android internal storage (/storage/emulated/0) into the container (Android only)

${_title}Commands (manage a specific container -- requires --img):${_off}
  start                     Start the container (idempotent: no-op if already running)
  stop                      Stop the running container and clean up
  restart                   Stop (if running) then start the container
  enter [USER=root]         Start the container if needed, then launch a login shell
  exec <command...>         Execute a command inside a running container
  top                       List processes inside the running container
  inspect                   Show detailed information about the container

${_title}Commands (manage all containers -- no --img needed):${_off}
  ps                        List running containers (id, pid, mntns, img, mp)
  help                      ${_desc}Show this help message${_off}
EOF
    exit 1
}

cmd::top() {
    check::img
    app::escalate "$@"
    check::is_already_running

    local mntns=$(this::ensure_ns mntns)
    ps -e -o uid,pid,mntns,args --no-headers |
        awk -v mntns="$mntns" 'BEGIN { printf "%6s %7s  %s\n", "UID", "PID", "COMMAND" } $3 == mntns { printf "%6s %7s  %s\n", $1, $2, substr($0, index($0, $4)) }'
}

cmd::exec() {
    check::img
    app::escalate "$@"
    check::is_already_running

    local nspid=$(this::ensure_ns pid) cmd=("$@")
    exec -c nsenter -t "$nspid" -m -u chroot "${GLOBAL[mountpoint]}" /bin/su -c "${cmd[*]}"
}

cmd::ps() {
    app::escalate "$@"

    local pidfile hash img mp nspid mntns
    for pidfile in /tmp/lina_*.pid; do
        hash="${pidfile##*/lina_}" hash="${hash%.pid}"
        img=$(mount | grep "/mnt/lina/${hash}" | awk '{print $1}')
        [[ -n $img ]] || continue

        nspid=$(< "$pidfile") mntns=$(pure::get_mntns_by_pid "$nspid")
        mp="/mnt/lina/${hash}"
        printf "%b" "id=$hash pid=$nspid mntns=$mntns img=$img mp=$mp\n"
    done
}

cmd::inspect() {
    check::img
    app::escalate "$@"
    cat << EOF
Container:
  ${GLOBAL[imghash]}

Status:
  $(this::check_running && printf "Running" || printf "Stopped")

PID:
  $(this::check_running && this::ensure_ns pid || printf "No Running")

Mntns:
  $(this::check_running && this::ensure_ns mntns || printf "No Running")

MountPoint:
  $(this::check_running && printf "Mounted" || printf "No Mount") ${GLOBAL[mountpoint]}
EOF
}

# 进入容器终端，未启动则自动启动
# check::img / app::escalate 委托给 cmd::start
cmd::enter() {
    local user="${1:-root}"
    cmd::start
    local nspid=$(this::ensure_ns pid)

    # printf '%s\n' "$$" | tee /dev/cpuctl/cgroup.procs /dev/cpuset/cgroup.procs /dev/memcg/cgroup.procs > /dev/null 2>&1
    exec env -i TERM="$TERM" nsenter -t "$nspid" -m -u chroot "${GLOBAL[mountpoint]}" /bin/su - "$user"
}

# 启动容器，若已启动则不进行操作
cmd::start() {
    check::img
    app::escalate "$@"

    this::check_running && return 0

    printf "${_ok}>${_off} Starting container: %s...\n" "${GLOBAL[imghash]}"

    this::set_mp

    # 必须先设置宿主挂载点、再创建命名空间
    local nspid=$(this::ensure_ns pid)
    printf "Create NS (PID: %s)\n" "$nspid"

    this::mountfs

    # shellcheck disable=SC2016
    env -i nsenter -t "$nspid" -m -u chroot "${GLOBAL[mountpoint]}" /bin/sh -c '[ -e /proc/sys/kernel/hostname ] && [ -r /etc/hostname ] && read -r HN < /etc/hostname && printf "%s\n" "$HN" > /proc/sys/kernel/hostname'
}

cmd::stop() {
    check::img
    app::escalate "$@"
    check::is_already_running

    local pid_dir pid pids=()
    for pid_dir in /proc/[0-9]*; do
        pid="${pid_dir##*/}"
        [[ /proc/$pid/root -ef ${GLOBAL[mountpoint]} ]] && pids+=("$pid")
    done
    if ((${#pids[@]})); then
        kill "${pids[@]}" 2> /dev/null || true
        sleep 2
        kill -9 "${pids[@]}" 2> /dev/null || true
    fi

    kill "$(this::ensure_ns pid)" 2> /dev/null || true
    mountpoint -q "${GLOBAL[mountpoint]}" 2> /dev/null && (umount "${GLOBAL[mountpoint]}" || umount -l "${GLOBAL[mountpoint]}")
    rmdir "${GLOBAL[mountpoint]}" 2> /dev/null || true
    rm -f "${GLOBAL[pidfile]}"

    printf "%s\n" "${GLOBAL[imghash]}"
}

# check::img / app::escalate 委托给 cmd::stop 和 cmd::start
cmd::restart() {
    this::check_running && {
        local nspid=$(this::ensure_ns pid)
        printf "${_ok}>${_off} Stopping container: %s (PID: %s)...\n" "${GLOBAL[imghash]}" "$nspid"
        cmd::stop "$@"
    }
    cmd::start "$@"
}

cmd::help() { usage; }

init::options() {
    declare -gA OPTIONS=() GLOBAL=()
    declare -ga ARGS=()

    while (($# > 0)); do
        case "$1" in
            -i | --img | --img=*)
                if [[ $1 == --img=* ]]; then
                    OPTIONS[img]="${1#*=}"
                    shift
                else
                    OPTIONS[img]="${2:-}"
                    shift 2
                fi
                [[ -n ${OPTIONS[img]} ]] || app::die "${_err}×${_off} --img requires a path argument.\n"
                [[ -f ${OPTIONS[img]} ]] || app::die "${_err}×${_off} File not found: ${OPTIONS[img]}\n"
                OPTIONS[img]=$(realpath "${OPTIONS[img]}")
                GLOBAL[imghash]=$(printf '%s' "${OPTIONS[img]}" | sha256sum | awk '{print $1}')
                GLOBAL[imghash]="${GLOBAL[imghash]:0:8}"
                GLOBAL[pidfile]="/tmp/lina_${GLOBAL[imghash]}.pid"
                GLOBAL[mountpoint]="/mnt/lina/${GLOBAL[imghash]}"
                ;;
            -S | --android-storage)
                OPTIONS[android_storage]=1
                shift
                ;;
            *)
                ARGS+=("$1")
                shift
                ;;
        esac
    done
}

main() {
    [[ -t 1 || -n ${FORCE_COLOR:-} ]] && declare -g _b=$'\e[1m' _hl=$'\e[35m' _yellow=$'\e[33m' _cyan=$'\e[34m' _title=$'\e[1;3;4m' _off=$'\e[0m' _err=$'\e[31m' _ok=$'\e[32m' _desc=$'\e[2m' _c1=$'\e[1;38;2;108;5;0;48;2;255;115;108m' _c2=$'\e[1;38;2;2;40;109;48;2;121;167;252m' _c3=$'\e[1;38;2;128;0;30;48;2;255;174;193m' _c4=$'\e[1;38;2;77;68;0;48;2;255;226;2m'

    SCRIPT_ARGV=("$@")
    init::options "$@"
    set -- "${ARGS[@]}"

    local fn="cmd::${1:-}"
    [[ -n $1 ]] || app::die "${_err}×${_off} Missing command.\n${_ok}>${_off} Run '${_hl}${0##*/} help${_off}' for usage information.\n"

    if declare -f "$fn" > /dev/null 2>&1; then
        "$fn" "${@:2}"
    else
        app::die "${_err}×${_off} Unknown command: $1\n${_ok}>${_off} Run '${_hl}${0##*/} help${_off}' for usage information.\n"
    fi
}

[[ ${BASH_SOURCE[0]} == "${0}" ]] && main "$@"

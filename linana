#!/usr/bin/env bash

# shellcheck disable=SC2155

app::escalate() {
    (($(id -u) != 0)) && {
        [[ -f /system/build.prop ]] || app::die "${_err}×${_off} Non-Android environment. Please run with sudo.\n"
        exec su --mount-master -c "$(printf "%q " env -i PATH=/data/data/com.termux/files/usr/bin:/system/bin:/system/xbin HOME=/data/data/com.termux/files/home/.suroot TERM="$TERM" LD_PRELOAD="/data/data/com.termux/files/usr/lib/libtermux-exec-ld-preload.so" "$(command -v bash || printf "%s" "/data/data/com.termux/files/usr/bin/bash")" "$(readlink -f "$0")" "${SCRIPT_ARGV[@]}")"
    }
}

app::die() {
    # shellcheck disable=SC2059
    printf -- "$@" >&2
    exit 1
}

this::ensure() {
    this::check_running && {
        cat "${GLOBAL[pidfile]}"
        return 0
    }

    setsid unshare -m -u sleep infinity > /dev/null 2>&1 &
    local pid=$!
    printf '%s\n' "$pid" | tee "${GLOBAL[pidfile]}"
}

this::check_running() { [[ -f ${GLOBAL[pidfile]} ]] && nsenter -t "$(< "${GLOBAL[pidfile]}")" -m -- mountpoint -q "${GLOBAL[mountpoint]}" 2> /dev/null; }

check::is_already_running() { this::check_running || app::die "${_err}×${_off} Container not running: ${GLOBAL[imghash]}\n"; }

check::img() { [[ -n ${OPTIONS[img]} ]] || app::die "${_err}×${_off} --img is required for this command.\n"; }

this::get_tops() {
    local -n __ref=$1
    __ref=()
    local pid_dir pid ref_pid=$(this::ensure)
    for pid_dir in /proc/[0-9]*; do
        pid="${pid_dir##*/}"
        [[ /proc/$pid/ns/mnt -ef /proc/$ref_pid/ns/mnt ]] && __ref+=("$pid")
    done
}

cmd::top() {
    check::img
    app::escalate "$@"
    check::is_already_running

    local -a pids
    this::get_tops pids
    printf "%6s %7s %s\n" "UID" "PID" "COMMAND"
    ((${#pids[@]})) && {
        printf -v pids_c "%s," "${pids[@]}"
        ps -p "${pids_c%,}" -o uid:6,pid:7,args --no-headers
    }
}

cmd::exec() {
    check::img
    app::escalate "$@"
    check::is_already_running

    local cmd=("$@")
    exec -c nsenter -t "$(this::ensure)" -m -u chroot "${GLOBAL[mountpoint]}" /bin/su -c "${cmd[*]}"
}

cmd::ps() {
    app::escalate "$@"

    local pidfile hash img
    for pidfile in /tmp/lina_*.pid; do
        hash="${pidfile##*/lina_}" hash="${hash%.pid}"
        img=$(mount | grep "/mnt/lina/${hash}" | awk '{print $1}')
        [[ -n $img ]] || continue
        printf "%b" "id=$hash pid=$(< "$pidfile") img=$img mountpoint=/mnt/lina/${hash}\n"
    done
}

cmd::inspect() {
    check::img
    app::escalate "$@"
    cat << EOF
Container:
  ${GLOBAL[imghash]}

IMG:
  ${OPTIONS[img]}

Status:
  $(this::check_running && printf "Running" || printf "Stopped")

PID:
  $(this::check_running && this::ensure || printf "No Running")

MountPoint:
  $(this::check_running && printf "Mounted" || printf "No Mount") ${GLOBAL[mountpoint]}
EOF
}

cmd::enter() {
    cmd::start
    exec env -i TERM="$TERM" nsenter -t "$(this::ensure)" -m -u chroot "${GLOBAL[mountpoint]}" /bin/su - "${1:-root}"
}

cmd::start() {
    check::img
    app::escalate "$@"

    this::check_running && return 0

    printf "${_ok}>${_off} Starting container: %s...\n" "${GLOBAL[imghash]}"

    printf "Setting mountpoint...\n"
    mountpoint -q "${GLOBAL[mountpoint]}" || {
        mkdir -p "${GLOBAL[mountpoint]}"
        mount "${OPTIONS[img]}" "${GLOBAL[mountpoint]}"
    }

    printf "Created ns (PID: %s)\n" "$(this::ensure)"

    printf "Mount filesystem...\n"
    nsenter -t "$(this::ensure)" -m -u -- bash -s "${GLOBAL[mountpoint]}" "${OPTIONS[android_storage]:-0}" << 'SCRIPT'
        MP=$1 STORAGE=${2:-0}
        mounts=(/dev:bind /dev/pts:bind /proc:bind /sys:bind /tmp:tmpfs /run:tmpfs)
        ((STORAGE==1)) && mounts+=("/storage/emulated/0:rbind")
for entry in "${mounts[@]}"; do
    IFS=: read -r src mtype <<< "$entry"
    dst="${MP%/}${src}"
    mkdir -p "$dst"
    mountpoint -q "$dst" && continue
    case $mtype in
        bind|rbind) [[ -d $src ]] && mount --$mtype "$src" "$dst" ;;
        tmpfs)      mount -t tmpfs tmpfs "$dst" ;;
    esac
done
SCRIPT

    # shellcheck disable=SC2016
    env -i nsenter -t "$(this::ensure)" -m -u chroot "${GLOBAL[mountpoint]}" /bin/sh -c '[ -e /proc/sys/kernel/hostname ] && [ -r /etc/hostname ] && read -r HN < /etc/hostname && printf "%s\n" "$HN" > /proc/sys/kernel/hostname'
}

cmd::stop() {
    check::img
    app::escalate "$@"
    check::is_already_running

    local -a pids
    this::get_tops pids
    if ((${#pids[@]})); then
        kill "${pids[@]}" 2> /dev/null || true
        sleep 2
        kill -9 "${pids[@]}" 2> /dev/null || true
    fi

    kill "$(this::ensure)" 2> /dev/null || true
    mountpoint -q "${GLOBAL[mountpoint]}" 2> /dev/null && (umount "${GLOBAL[mountpoint]}" || umount -l "${GLOBAL[mountpoint]}")
    rmdir "${GLOBAL[mountpoint]}" 2> /dev/null || true
    rm -f "${GLOBAL[pidfile]}"

    printf "%s\n" "${GLOBAL[imghash]}"
}

cmd::restart() {
    this::check_running && {
        printf "${_ok}>${_off} Stopping container: %s (PID: %s)...\n" "${GLOBAL[imghash]}" "$(this::ensure)"
        cmd::stop "$@"
    }
    cmd::start "$@"
}

